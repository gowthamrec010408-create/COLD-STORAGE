rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper authentication checks
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isApprovedUser() {
      return !isAuthenticated() || (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
      );
    }
    
    function isAdmin() {
      return !isAuthenticated() || (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // User Accounts Collection
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Produce Batches Collection (Harvest & Storage inventory)
    match /produceBatches/{batchId} {
      allow read: if true;
      allow write: if true;
    }

    // Sensor Calibration Collection (HX711, MQ-137 Ethylene, SHT31 Probes)
    match /sensorCalibration/{sensorId} {
      allow read: if true;
      allow write: if true;
    }

    // Hardware Devices & Telemetry Diagnostics
    match /devices/{deviceId} {
      allow read: if true;
      allow write: if true;
    }

    // Diagnostics & Health Pings
    match /diagnostics/{docId} {
      allow read, write: if true;
    }

    // Immutable Audit Logs
    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
