rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isApprovedUser() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }
    
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User Collection Rules
    match /users/{userId} {
      // Any authenticated user can read their own profile; admins can read all
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // New users can create profile during registration, but status must be 'pending' and role 'user'
      allow create: if isAuthenticated() && request.auth.uid == userId &&
        request.resource.data.status == 'pending' &&
        request.resource.data.role == 'user';
        
      // Only admins can update status (approve/reject/disable) or roles
      allow update: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'role'])
      );
      
      allow delete: if isAdmin();
    }

    // Produce Batches Collection
    match /produceBatches/{batchId} {
      allow read: if isApprovedUser();
      allow write: if isApprovedUser();
    }

    // Sensor Calibration Collection (Admin / Technician only)
    match /sensorCalibration/{sensorId} {
      allow read: if isApprovedUser();
      allow write: if isAdmin();
    }

    // Devices & Diagnostics
    match /devices/{deviceId} {
      allow read: if isApprovedUser();
      allow write: if isAdmin();
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isApprovedUser();
      allow update, delete: if false; // Immutable audit trail
    }
  }
}
